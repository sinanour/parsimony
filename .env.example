# Copy to .env (git-ignored) for local runs: `npm start` / `npm run dev`.
# Every setting is optional; defaults are shown.

# --- Data -------------------------------------------------------------------
# DATA_DIR=./data                         # database, backups and generated JWT secret
# DATABASE_PATH=$DATA_DIR/parsimony.sqlite
# BACKUP_DIR=$DATA_DIR/backups
# BACKUP_KEEP=10
# BACKUP_ON_START=true

# --- Server -----------------------------------------------------------------
# HOST=127.0.0.1
# PORT=3001
# TRUST_PROXY=false                       # true only behind a reverse proxy that sets X-Real-IP / X-Forwarded-Proto

# --- Formatting -------------------------------------------------------------
# CURRENCY=CAD
# LOCALE=en-CA

# --- First administrator (used only while no users exist) -------------------
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=change-me-to-something-long

# --- Auth -------------------------------------------------------------------
# JWT_SECRET=                             # ≥ 32 chars; generated and stored in DATA_DIR when unset
# ACCESS_TOKEN_TTL=15m
# REFRESH_TOKEN_TTL=7d
# COOKIE_SECURE=auto                      # auto | true | false
# AUTH_RATE_LIMIT_PER_MINUTE=10          # per IP: setup / forgot / reset password; per user: password change
# LOGIN_IP_FAILURES_PER_MINUTE=100       # failed sign-ins per IP (successes never count)
# LOGIN_LOCKOUT_THRESHOLD=5              # consecutive failures per email before a temporary lock (0 = off)
# LOGIN_LOCKOUT_BASE=1m                  # first lock; doubles with each further failure ...
# LOGIN_LOCKOUT_MAX=15m                  # ... up to this
# REFRESH_RATE_LIMIT_PER_MINUTE=30       # per session
# API_RATE_LIMIT_PER_MINUTE=600
# HEAVY_RATE_LIMIT_PER_MINUTE=30         # per user: statement parse/commit, rule runs, statement-format saves
# IMPORT_MAX_RECORDS=10000               # most records per statement parse / import commit
# RULES_MAX_PER_SCOPE=2000               # most categorization rules per scope
# AUDIT_RETENTION_DAYS=365

# --- Password-reset email (optional; the feature is off without SMTP_HOST) ---
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false                       # true for port 465
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=Parsimony <noreply@example.com>
# PUBLIC_URL=https://parsimony.example.com   # used in reset links; defaults to the request's origin
