# Parsimony web UI: the built SPA served by nginx, which also proxies /api to the backend.
# Build from the repository root:
#   docker build -f deployment/dockerfiles/Dockerfile.frontend -t parsimony-frontend .
FROM node:24-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
COPY backend-api/package.json backend-api/package.json
COPY web-frontend/package.json web-frontend/package.json
RUN npm ci --workspace web-frontend --include-workspace-root=false
COPY shared shared
COPY web-frontend web-frontend
RUN npm run build --workspace web-frontend

FROM nginx:1.27-alpine
# Source maps stay out of the image.
COPY --from=build /app/web-frontend/dist /usr/share/nginx/html
RUN find /usr/share/nginx/html -name '*.map' -delete && rm -f /etc/nginx/conf.d/default.conf
COPY deployment/dockerfiles/nginx/nginx.conf /etc/nginx/nginx.conf
COPY deployment/dockerfiles/nginx/snippets /etc/nginx/snippets
COPY deployment/dockerfiles/nginx/configure-parsimony.sh /docker-entrypoint.d/40-configure-parsimony.sh
RUN chmod 0755 /docker-entrypoint.d/40-configure-parsimony.sh
EXPOSE 80 443
