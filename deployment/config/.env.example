# Parsimony deployment configuration.
# Copy to .env (git-ignored) and edit. `npm run deploy` validates it and uploads it to the target
# host with mode 0600. It is passed to the API container, so any backend setting from the
# repository's top-level .env.example can be added here too.

COMPOSE_PROJECT_NAME=parsimony

# --- Network ----------------------------------------------------------------
# Host ports nginx listens on. Use e.g. 8080/8443 if 80/443 are taken.
HTTP_PORT=80
HTTPS_PORT=443
# BIND_ADDRESS=0.0.0.0                    # 127.0.0.1 to expose only to a reverse proxy on the same host
# SERVER_NAME=parsimony.example.com      # nginx server_name; "_" (any) by default

# --- HTTPS ------------------------------------------------------------------
# Put the certificate and key in deployment/config/certs/ (see config/README.md), then:
ENABLE_HTTPS=false
# HTTPS_REDIRECT=true                    # redirect HTTP to HTTPS when HTTPS is on

# --- Data -------------------------------------------------------------------
# Absolute directory on the host for the database, backups and JWT secret. Defaults to a named volume.
# DATA_VOLUME_PATH=/srv/parsimony/data
# BACKUP_KEEP=10

# --- First administrator (only used while no users exist) -------------------
# Leave unset to create the administrator in the browser with the setup code from `npm run logs`.
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=

# --- Formatting -------------------------------------------------------------
CURRENCY=CAD
LOCALE=en-CA

# --- Auth (optional) --------------------------------------------------------
# JWT_SECRET=                            # ≥ 32 chars; generated on the data volume when unset
# ACCESS_TOKEN_TTL=15m
# REFRESH_TOKEN_TTL=7d
# AUTH_RATE_LIMIT_PER_MINUTE=10          # per IP: setup / forgot / reset password; per user: password change
# LOGIN_IP_FAILURES_PER_MINUTE=100       # failed sign-ins per IP (successes never count)
# LOGIN_LOCKOUT_THRESHOLD=5              # consecutive failures per email before a temporary lock (0 = off)
# LOGIN_LOCKOUT_BASE=1m                  # first lock; doubles with each further failure ...
# LOGIN_LOCKOUT_MAX=15m                  # ... up to this
# REFRESH_RATE_LIMIT_PER_MINUTE=30       # per session
# API_RATE_LIMIT_PER_MINUTE=600
# HEAVY_RATE_LIMIT_PER_MINUTE=30         # per user: statement parse/commit, rule runs, statement-format saves
# IMPORT_MAX_RECORDS=10000               # most records per statement parse / import commit
# RULES_MAX_PER_SCOPE=2000               # most categorization rules per scope
# AUDIT_RETENTION_DAYS=365

# --- Password reset by email (optional; needs SMTP_HOST and PUBLIC_URL) -------
# PUBLIC_URL=https://parsimony.example.com
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=Parsimony <noreply@example.com>
